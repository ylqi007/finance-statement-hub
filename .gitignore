.env
.env.*
!.env.example

# Python
__pycache__/    # 忽略任意位置中，名字为 __pycache__ 的目录，以及目录里的所有内容。
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environment
.venv/
venv/

# IDE and OS
.vscode/
.idea/
